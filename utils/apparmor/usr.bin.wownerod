#include <tunables/global>

profile lolnerod /usr/{,local/}bin/lolnerod {
  #include <abstractions/base>
  #include <abstractions/openssl>

  /etc/inputrc r,
  /etc/terminfo/** r,

  /sys/devices/**/rotational r,

  owner /home/*/.lolnero/{,/testnet/,/stagenet/} w,
  owner /home/*/.lolnero/{,/testnet/,/stagenet/}lmdb/ w,
  owner /home/*/.lolnero/{,/testnet/,/stagenet/}lmdb/* rwk,
  owner /home/*/.lolnero/{,/testnet/,/stagenet/}p2pstate.bin rw,
  owner /home/*/.lolnero/{,/testnet/,/stagenet/}lolnero.conf r,
  owner /home/*/.lolnero/{,/testnet/,/stagenet/}lolnero.log w,

}
