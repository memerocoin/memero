[Unit]
Description=Wownero Full Node
After=network.target

[Service]
User=lolnero
Group=lolnero
WorkingDirectory=~
RuntimeDirectory=lolnero
StateDirectory=lolnero
LogsDirectory=lolnero

# Clearnet config
#
Type=forking
PIDFile=/run/lolnero/lolnerod.pid
ExecStart=/usr/bin/lolnerod --config-file /etc/lolnerod.conf \
    --detach --pidfile /run/lolnero/lolnerod.pid

# Tor config
#
## We have to use simple, not forking, because we cannot pass --detach
## because stderr/stdout is not available when detached, but torsocks
## attempts to write to it, and fails with 'invalid argument', causing
## lolnerod to fail.
#Type=simple
#Environment=DNS_PUBLIC=tcp
## The following is needed only when accessing wallet from a different
## host in the LAN, VPN, etc, the RPC must bind to 0.0.0.0, but
## by default torsocks only allows binding to localhost.
#Environment=TORSOCKS_ALLOW_INBOUND=1
#ExecStart=/usr/bin/torsocks /usr/bin/lolnerod --config-file /etc/lolnerod.conf \
#    --non-interactive

Restart=always

[Install]
WantedBy=multi-user.target
